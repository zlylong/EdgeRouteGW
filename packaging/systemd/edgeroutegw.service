[Unit]
Description=EdgeRouteGW 2.0 control plane
Documentation=https://github.com/zlylong/EdgeRouteGW
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/edgeroutegw/edgeroutegw.env
ExecStart=/usr/bin/edgeroutegw serve
# always: systemd counts death by SIGHUP as a clean exit, and a HUP that
# lands in the exec window (before the Go runtime installs handlers) must
# not leave the gateway without its control plane.
Restart=always
RestartSec=1
LimitNOFILE=1048576

# 2.0 runs as root (design decision 5); the capability set is bounded so a
# compromise of the process cannot do more than the network stack needs.
# CAP_SYS_ADMIN is required to restart units over D-Bus until polkit rules
# land with the dedicated-user change planned for 2.1.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027
ReadWritePaths=/var/lib/edgeroutegw /etc/edgeroutegw /etc/frr /etc/nftables.conf
# Retention settings own a journald drop-in and vacuum the journal.
ReadWritePaths=-/etc/systemd/journald.conf.d -/var/log/journal -/run/log/journal
RuntimeDirectory=edgeroutegw
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=edgeroutegw
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target

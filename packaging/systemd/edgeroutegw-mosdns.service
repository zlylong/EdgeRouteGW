[Unit]
Description=Mosdns (managed by EdgeRouteGW)
Documentation=https://github.com/IrineSistiana/mosdns
After=network-online.target
Wants=network-online.target
PartOf=edgeroutegw.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/edgeroutegw/mosdns
ExecStart=/var/lib/edgeroutegw/components/mosdns/mosdns start -d /var/lib/edgeroutegw/mosdns -c config.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/var/lib/edgeroutegw/mosdns /run/edgeroutegw
RuntimeDirectory=edgeroutegw
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Xray-core (managed by EdgeRouteGW)
Documentation=https://github.com/XTLS/Xray-core
After=network-online.target nss-lookup.target
Wants=network-online.target
PartOf=edgeroutegw.service

[Service]
Type=simple
User=root
Environment=XRAY_LOCATION_ASSET=/var/lib/edgeroutegw/geodata
WorkingDirectory=/var/lib/edgeroutegw/xray
ExecStart=/var/lib/edgeroutegw/components/xray/xray run -config /var/lib/edgeroutegw/xray/config.json
Restart=on-failure
RestartSec=3
# Exit 23 is a config/asset error that a restart cannot fix.
RestartPreventExitStatus=23
LimitNOFILE=1048576
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0027
ReadWritePaths=/var/lib/edgeroutegw/xray /run/edgeroutegw
RuntimeDirectory=edgeroutegw
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
